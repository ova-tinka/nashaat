# Set this only after the public domain has been approved and configured.
NEXT_PUBLIC_BLOOM_SITE_URL=

# Browser account deletion uses public Supabase client credentials only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only waitlist service configuration.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BLOOM_RATE_LIMIT_SECRET=
BLOOM_LINK_SIGNING_SECRET=

# SMTP credentials. No waitlist data is accepted until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SUPPORT_INBOX=
