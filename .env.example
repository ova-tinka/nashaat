# ==============================================================================
# Bloom — Environment Variables & Key Acquisition Guide
# ==============================================================================
# Copy this file to `.env` in the repository root for local/app builds:
#   cp .env.example .env
#
# SECURITY RULES:
# 1. Never commit `.env` (it is gitignored).
# 2. Only `EXPO_PUBLIC_*` variables belong in `.env` — they are bundled into the
#    client app. Never put secret keys (Supabase service role, RevenueCat secret,
#    Tap secret, Fireworks API key) into `.env` or any `EXPO_PUBLIC_*` variable.
# 3. Put server-side secrets in Supabase Edge Function secrets instead:
#    supabase secrets set KEY=VALUE
# ==============================================================================


# ------------------------------------------------------------------------------
# SECTION 1: Client App `.env` (Public / Publishable — safe in root `.env`)
# ------------------------------------------------------------------------------

# Supabase Project URL (e.g. https://abcdefghijklmno.supabase.co)
# How to get: Supabase Dashboard -> Your Project -> Project Settings (gear) ->
#   Data API (or API) -> Project URL.
EXPO_PUBLIC_SUPABASE_URL=

# Supabase Publishable / Anon Key (safe for client apps; protected by RLS)
# How to get: Supabase Dashboard -> Project Settings -> API Keys ->
#   copy the `publishable` key (`sb_publishable_...`) or legacy `anon` public key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public Web Origin for Bloom (e.g. https://app.yourdomain.com)
# Used for Web Reader links, macOS external checkout links, and password reset redirects.
# Local dev can use http://localhost:8081; production must be HTTPS with no trailing slash.
EXPO_PUBLIC_BLOOM_WEB_URL=

# RevenueCat Public SDK Keys (iOS & Android)
# How to get: RevenueCat Dashboard -> Your Project -> Project Settings -> API Keys ->
#   Public app-specific API keys:
#   - Apple App Store app key (`appl_...`) -> EXPO_PUBLIC_REVENUECAT_IOS_KEY
#   - Google Play Store app key (`goog_...`) -> EXPO_PUBLIC_REVENUECAT_ANDROID_KEY
#   Use sandbox/test store keys for sandbox builds and live store keys for release builds.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Runtime environment tag sent to Sentry and Amplitude (`development`, `staging`, or `production`)
EXPO_PUBLIC_APP_ENV=production

# Sentry Client DSN (optional locally; required for production crash monitoring)
# How to get: Sentry.io -> Create/select React Native (or Expo) project ->
#   Settings -> Projects -> <Your Project> -> Client Keys (DSN) -> copy DSN URL.
EXPO_PUBLIC_SENTRY_DSN=

# Amplitude Analytics API Key (optional locally; required for production funnel metrics)
# Note: Bloom automatically suppresses all Amplitude events for child accounts.
# How to get: Amplitude -> Organization Settings -> Projects -> <Bloom Project> ->
#   General -> copy the API Key.
EXPO_PUBLIC_AMPLITUDE_API_KEY=

# Amplitude HTTP v2 endpoint:
# - US Standard Residency: https://api2.amplitude.com/2/httpapi
# - EU Residency:          https://api.eu.amplitude.com/2/httpapi
EXPO_PUBLIC_AMPLITUDE_ENDPOINT=https://api2.amplitude.com/2/httpapi


# ------------------------------------------------------------------------------
# SECTION 2: Supabase Edge Function Secrets (NEVER put in client `.env`)
# ------------------------------------------------------------------------------
# Set these on your Supabase project via CLI or Dashboard -> Edge Functions -> Secrets:
#   supabase secrets set BLOOM_BILLING_ENVIRONMENT=sandbox ...
#
# Note: `SUPABASE_URL`, `SUPABASE_ANON_KEY` (or `SUPABASE_PUBLISHABLE_KEYS`), and
# `SUPABASE_SERVICE_ROLE_KEY` (or `SUPABASE_SECRET_KEYS`) are auto-injected by
# Supabase into deployed Edge Functions.

# --- Billing Core ---
# Must be exactly `sandbox` or `production`.
# BLOOM_BILLING_ENVIRONMENT=production

# Base URL of your Supabase Edge Functions (no trailing slash):
#   https://<project-ref>.supabase.co/functions/v1
# BLOOM_BILLING_FUNCTION_BASE=

# Exact HTTPS origin of your Bloom web checkout site (must match EXPO_PUBLIC_BLOOM_WEB_URL,
# no trailing slash). Used for Tap CORS + return/cancel redirects.
# BLOOM_BILLING_WEB_ORIGIN=

# Random shared secret you generate for scheduled billing worker / cron calls:
#   openssl rand -hex 32
# Also store the same token in your pg_cron / Vault billing worker setup.
# BLOOM_BILLING_WORKER_TOKEN=

# --- RevenueCat Server Sync & Webhook ---
# RevenueCat Secret API Key (`sk_...`) — NEVER use the `appl_`/`goog_` public key here!
# How to get: RevenueCat Dashboard -> Project Settings -> API Keys -> Secret API keys ->
#   Create new secret key (v1/v2 read access to subscribers).
# BLOOM_REVENUECAT_SECRET_KEY=

# Random bearer token you generate (`openssl rand -hex 32`) and paste into:
#   RevenueCat Dashboard -> Integrations -> Webhooks -> Authorization header (`Bearer <token>`)
#   Webhook URL: https://<project-ref>.supabase.co/functions/v1/bloom-revenuecat/webhook
# BLOOM_REVENUECAT_WEBHOOK_TOKEN=

# --- Tap Payments (Web & macOS external checkout) ---
# Tap Secret API Key (`sk_test_...` for sandbox, `sk_live_...` for production)
# How to get: Tap Dashboard (dashboard.tap.company) -> goSell / Developers -> API Credentials.
# BLOOM_TAP_SECRET_KEY=

# Minor-unit verification amount for card-update checks (e.g. `100` for 1.00 USD / 100 fils, etc.)
# BLOOM_TAP_CARD_CHECK_MINOR=100

# Set to `true` only if your Tap merchant account has variable-amount recurring agreements enabled.
# BLOOM_TAP_VARIABLE_RENEWALS=false

# --- AI Features (Fireworks AI: Coach, Study Tutor, Document Help, Reading Reflection, Mock Exam) ---
# How to get: Fireworks AI (fireworks.ai) -> Account -> API Keys -> Create API Key.
# Also set a hard monthly spend limit in Fireworks Dashboard -> Billing -> Usage Limits.
# FIREWORKS_API_KEY=
# FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct
# BLOOM_COACH_ENABLED=true
# FIREWORKS_DATA_SHARING_APPROVED=true
# FIREWORKS_MODEL_VERIFIED=true
# BLOOM_MINOR_COACH_APPROVED=false
# Keep `BLOOM_COACH_TEST_MODE`, `BLOOM_COACH_TEST_USER_ID`, `BLOOM_COACH_TEST_EXPIRES_AT` UNSET in production.

# --- Backend Sentry (Edge Functions) ---
# How to get: Sentry.io -> Deno / Edge project (or same project) -> Client Keys (DSN).
# BLOOM_SENTRY_DSN=


# ------------------------------------------------------------------------------
# SECTION 3: Optional Local macOS Signing & Extension Packaging (CLI only)
# ------------------------------------------------------------------------------
# Only needed when running `npm run desktop:sign` or `npm run build:macos-filter` locally.
# Check local identities with: security find-identity -v -p codesigning
# Profiles live in ~/Library/Developer/Xcode/UserData/Provisioning Profiles/ or Apple Developer Portal.

# BLOOM_TEAM_ID=SSYR69RTPK
# APPLE_SIGNING_IDENTITY=Developer ID Application: Ayham Dwairy (SSYR69RTPK)
# BLOOM_HOST_PROFILE=
# BLOOM_FILTER_PROFILE=
# BLOOM_SAFARI_PROFILE=
# BLOOM_CHROME_EXTENSION_ID=
